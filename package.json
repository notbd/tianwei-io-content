{
  "name": "tianwei-io-content",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.23.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "dev:up": "pnpm db:up && pnpm db:migrate && pnpm content:start",
    "dev:down": "pnpm db:down",
    "dev:reset": "pnpm db:reset && pnpm db:migrate && pnpm content:start",

    "db:up": "docker compose --env-file .env.local up -d",
    "db:down": "docker compose --env-file .env.local down",
    "db:reset": "docker compose --env-file .env.local down -v && pnpm db:up",
    "db:migrate": "sleep 3 && pnpm drizzle-kit push",

    "content:start": "tsx scripts/services.ts startLocalContentService",
    "content:init": "tsx scripts/services.ts runInitialSync",
    "content:watch": "tsx scripts/services.ts runContentWatcher",

    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^3.0.0",
    "chokidar": "^4.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "gray-matter": "^4.0.3",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "eslint": "^9.38.0",
    "pg-format": "^1.0.4"
  }
}
