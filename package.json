{
  "name": "tianwei-io-content",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "description": "Content engine for tianwei.io: parses MDX content and syncs it to Postgres",
  "author": "Tianwei Zhang",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev:up": "pnpm db:up && pnpm db:migrate && pnpm content:start",
    "dev:down": "pnpm db:down",
    "dev:reset": "pnpm db:reset && pnpm db:migrate && pnpm content:start",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:reset": "docker compose --env-file .env.local down -v && pnpm db:up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "content:start": "tsx scripts/local-dev.ts",
    "content:sync": "tsx scripts/local-dev.ts --no-watch",
    "sync:prod": "tsx scripts/sync-prod.ts",
    "frontend:revalidate": "tsx scripts/revalidate-frontend.ts",
    "new-post": "tsx scripts/new-post.ts",
    "check:contract": "tsx scripts/check-contract.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@sindresorhus/slugify": "^3.0.1",
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.2",
    "pg": "^8.23.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@electric-sql/pglite": "^0.5.14",
    "@types/js-yaml": "^3.12.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
