# ============================================================
# Environment configuration for tianwei-io-content
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.
# ============================================================

# ------------------------------------------------------------
# Local database (Docker)
# ------------------------------------------------------------
# Credentials for the local PostgreSQL container; consumed by
# docker-compose.yml and the local connection fallback in src/db.ts.

LOCAL_POSTGRES_USER=local_user
LOCAL_POSTGRES_PASSWORD=local_password
LOCAL_POSTGRES_DB=local_db_name

# CONTAINER port is standard Postgres; FORWARDED host port is
# non-standard to avoid clashing with a natively installed Postgres.
LOCAL_CONTAINER_DB_PORT=5432
LOCAL_FORWARDED_DB_PORT=5431

# ------------------------------------------------------------
# Remote database (optional locally)
# ------------------------------------------------------------
# When set, DATABASE_URL takes precedence over the LOCAL_* values.
# In CI this is provided via the PROD_REMOTE_DATABASE_URL secret.
# Format: postgresql://user:pass@host/db?sslmode=require

# DATABASE_URL=

# ------------------------------------------------------------
# Frontend revalidation
# ------------------------------------------------------------
# FRONTEND_URL: base URL of the Next.js frontend
# REVALIDATION_SECRET: bearer token for the frontend /api/revalidate route

FRONTEND_URL=https://example.com
REVALIDATION_SECRET=replace-with-a-long-random-string
