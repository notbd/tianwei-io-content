# ============================================================
# Environment configuration for tianwei-io-content
# ============================================================
# Copy this file to .env.local. `pnpm dev` needs none of it: its
# database is built in memory from the files.
# .env.local is gitignored; never commit real credentials.
# ============================================================

# ------------------------------------------------------------
# Remote database
# ------------------------------------------------------------
# Never set DATABASE_URL here. Local development does not read it,
# but pnpm db:migrate and pnpm sync:prod do, and would use that
# database without being told to. Every entry point that reads this
# file refuses one that sets it. Pass it for one command instead:
# DATABASE_URL=... pnpm sync:prod
# (the deploy workflow passes the PROD_REMOTE_DATABASE_URL secret).
# Format: postgresql://user:pass@host/db?sslmode=verify-full
# pg takes ssl settings from the URL when sslmode is present, so
# verify-full must be in the URL itself.

# ------------------------------------------------------------
# Frontend (pnpm dev, check:contract, frontend:revalidate)
# ------------------------------------------------------------
# FRONTEND_URL: a frontend on this machine. Unset, check:contract
#   and frontend:revalidate talk to production, https://tianwei.io
#   (the deploy workflow does not set it). Set to 127.0.0.1 or
#   localhost, it points those two at a local stack, and pnpm dev
#   expires that frontend's cache after every sync, so a reload
#   shows the save. pnpm dev never talks to any other host.
# REVALIDATION_SECRET: bearer token for the frontend's
#   /api/revalidate route; the same value as in the frontend's
#   .env.local.

# FRONTEND_URL=http://localhost:3000
REVALIDATION_SECRET=replace-with-a-long-random-string
