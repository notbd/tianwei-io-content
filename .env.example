# ============================================================
# Environment Configuration for tianwei-io-content
# ============================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Local Database (Docker)
# ------------------------------------------------------------
# Credentials for the local PostgreSQL container.
# Must match docker-compose.yml configuration.

LOCAL_POSTGRES_USER=local_user
LOCAL_POSTGRES_PASSWORD=local_password
LOCAL_POSTGRES_DB=local_db_name

# ------------------------------------------------------------
# Port Mapping
# ------------------------------------------------------------
# CONTAINER_DB_PORT: Internal container port (standard Postgres).
# FORWARDED_DB_PORT: Host port (non-standard to avoid conflicts).

LOCAL_CONTAINER_DB_PORT=5432
LOCAL_FORWARDED_DB_PORT=5431

# ------------------------------------------------------------
# Remote Database
# ------------------------------------------------------------
# Store remote db connection string here for local testing.
# This is NOT used automatically outside of test scripts.
#
# Format: postgres://user:password@example.region.example_db.com/dbname?sslmode=require

REMOTE_DATABASE_URL=

# ------------------------------------------------------------
# Notes
# ------------------------------------------------------------
# - Local dev (`pnpm dev:up`): Uses LOCAL_* variables
# - Local remote test (`pnpm test:remote`): Reads REMOTE_DATABASE_URL
# - CI/CD (GitHub Actions): Uses DATABASE_URL secret
